+#endif
+
+/* Avoid state corruption via bailout (CVE-2026-109618): print the fatal
+ * allocation error and _exit() immediately instead of running the normal
+ * E_ERROR handler and longjmp-ing (zend_bailout) out of a request whose
+ * memory may be only partially initialized. */
+ZEND_API void zend_mm_safe_error_ex(const char *format, ...)
+{
+	const char *error_filename;
+	uint error_lineno;
+	va_list args;
+	TSRMLS_FETCH();
+
+	if (zend_is_compiling(TSRMLS_C)) {
+		error_filename = zend_get_compiled_filename(TSRMLS_C);
+		error_lineno = zend_get_compiled_lineno(TSRMLS_C);
+	} else if (EG(in_execution)) {
+		error_filename = EG(active_op_array) ? EG(active_op_array)->filename : NULL;
+		error_lineno = EG(opline_ptr) ? (*EG(opline_ptr))->lineno : 0;
+	} else {
+		error_filename = NULL;
+		error_lineno = 0;
+	}
+	if (!error_filename) {
+		error_filename = "Unknown";
+	}
+
+	fprintf(stderr, "\nFatal error: ");
+	va_start(args, format);
+	vfprintf(stderr, format, args);
+	va_end(args);
+	fprintf(stderr, " in %s on line %d\n", error_filename, error_lineno);
+
+/* See http://support.microsoft.com/kb/190351 */
+#ifdef PHP_WIN32
+	fflush(stderr);
+#endif
+
+	_exit(1);
+}
